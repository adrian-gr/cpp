@startuml

interface Document {
    +display()
}

class RealDocument {
    -filename_: string
    +RealDocument(filename: string)
    +display()
}

class ProtectedDocumentProxy {
    -filename_: string
    -canView_: bool
    -document_: RealDocument
    +ProtectedDocumentProxy(filename: string, canView: bool)
    +display()
}

RealDocument ..|> Document
ProtectedDocumentProxy ..|> Document
ProtectedDocumentProxy o-- RealDocument : creates lazily

class Client {
    +preview(document: Document)
}

Client --> Document : uses

@enduml
